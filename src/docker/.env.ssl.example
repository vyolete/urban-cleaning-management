# SSL/HTTPS Example Configuration
# Usage: cp .env.ssl.example .env && docker-compose up --build
#
# The keystore is auto-generated inside the container on first startup.
# No Java installation required on the host machine.

# Database
DB_NAME=urbanclean
DB_USER=urbanclean_user
DB_PASSWORD=change_this_in_production
DB_PORT=5432

# Backend ports
# HTTP (8080) stays up — SSLConfiguration.java redirects it to HTTPS automatically
BACKEND_PORT=8080
BACKEND_HTTPS_PORT=8443
# Must be 8443 when SSL_ENABLED=true (Spring Boot HTTPS listener port)
SERVER_PORT=8443
SHOW_SQL=false

# JWT
JWT_SECRET=change_this_jwt_secret_key_in_production_use_at_least_256_bits
JWT_EXPIRATION=86400000

# Upload
MAX_FILE_SIZE=5242880

# Geofencing (Madrid defaults)
GEOFENCE_MIN_LAT=40.3
GEOFENCE_MAX_LAT=40.6
GEOFENCE_MIN_LON=-3.9
GEOFENCE_MAX_LON=-3.5

# Algorithm weights (must sum to 1.0)
ALGORITHM_WEIGHT_CATEGORY=0.40
ALGORITHM_WEIGHT_ZONE=0.35
ALGORITHM_WEIGHT_TIME=0.25
DEDUPLICATION_DISTANCE_METERS=50.0
DEDUPLICATION_TIME_WINDOW_HOURS=24

# Frontend
FRONTEND_PORT=3000
FRONTEND_NGINX_PORT=443  # Routes host:3000 → container:443 (HTTPS Nginx)
VITE_API_URL=/api        # Relative — Nginx proxies /api to HTTPS backend internally
VITE_MAP_CENTER_LAT=40.4168
VITE_MAP_CENTER_LON=-3.7038
VITE_MAP_ZOOM=13

# SSL — keystore is created automatically by docker-entrypoint.sh on first run
SSL_ENABLED=true
SSL_KEYSTORE_PATH=/etc/ssl/certs/keystore.p12
SSL_KEYSTORE_PASSWORD=change_this_ssl_password
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS=tomcat
# Host directory bind-mounted to /etc/ssl/certs inside the container
# keystore.p12 will be written here on first start and reused on subsequent restarts
SSL_CERT_PATH=./certs

# CORS — include both HTTP and HTTPS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
