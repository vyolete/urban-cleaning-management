# Database Configuration
DB_NAME=urbanclean
DB_USER=urbanclean_user
DB_PASSWORD=change_this_password_in_production
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=8080
SHOW_SQL=false

# JWT Configuration
# IMPORTANT: Generate a secure 512-bit (64 bytes) random key for production
# PowerShell: $bytes = New-Object byte[] 64; [Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# Linux/Mac: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change_this_jwt_secret_key_in_production_use_at_least_512_bits
JWT_EXPIRATION=86400000

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Geofencing Configuration (Madrid example)
GEOFENCE_MIN_LAT=40.3
GEOFENCE_MAX_LAT=40.6
GEOFENCE_MIN_LON=-3.9
GEOFENCE_MAX_LON=-3.5

# Algorithm Default Weights (must sum to 1.0)
ALGORITHM_WEIGHT_CATEGORY=0.40
ALGORITHM_WEIGHT_ZONE=0.35
ALGORITHM_WEIGHT_TIME=0.25

# Deduplication Configuration
DEDUPLICATION_DISTANCE_METERS=50.0
DEDUPLICATION_TIME_WINDOW_HOURS=24

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080/api
VITE_MAP_CENTER_LAT=40.4168
VITE_MAP_CENTER_LON=-3.7038
VITE_MAP_ZOOM=13
