# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urbanclean
DB_USER=urbanclean_user
DB_PASSWORD=change_this_password_in_production

# JWT Configuration
# IMPORTANTE: Este es un ejemplo. El sistema usa un JWT_SECRET seguro por defecto.
# Para producción, genera uno nuevo con: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change_this_to_a_secure_random_string_at_least_512_bits
JWT_EXPIRATION=86400000

# File Upload Configuration
UPLOAD_DIR=/uploads
MAX_FILE_SIZE=5242880

# Frontend Configuration
# Usa ruta relativa para evitar problemas de CORS
VITE_API_URL=/api
VITE_MAP_CENTER_LAT=40.4168
VITE_MAP_CENTER_LON=-3.7038
VITE_MAP_ZOOM=13

# Geofencing Configuration (example: Madrid area)
GEOFENCE_MIN_LAT=40.3
GEOFENCE_MAX_LAT=40.6
GEOFENCE_MIN_LON=-3.9
GEOFENCE_MAX_LON=-3.5

# Algorithm Default Weights
ALGORITHM_WEIGHT_CATEGORY=0.40
ALGORITHM_WEIGHT_ZONE=0.35
ALGORITHM_WEIGHT_TIME=0.25

# Deduplication Configuration
DEDUPLICATION_DISTANCE_METERS=50.0
DEDUPLICATION_TIME_WINDOW_HOURS=24

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@urbanclean.com
EMAIL_FROM_NAME=Urban Cleaning System
EMAIL_BASE_URL=http://localhost:3000
